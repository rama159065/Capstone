# Copy to .env and fill in. docker compose reads it; locally, load it into your shell.
# Never commit .env (it is gitignored).

# --- Hosted models (Track B endpoint; OpenAI-compatible) -----------------------------------
LLM_API_BASE=https://your-endpoint.example/v1
LLM_API_KEY=
LLM_MODEL=
# Course endpoint example: LLM_API_BASE=https://103.42.50.41:1034/v1, LLM_MODEL=Qwen/Qwen3-8B,
# LLM_API_KEY=<your group key>, LLM_CA_CERT=<path to the endpoint's CA .crt> (self-signed TLS)
# Empty = <RAG_HOME>/secrets/llm_ca.crt when that file exists
LLM_CA_CERT=
# Cap on generated tokens per call; empty = server default (course endpoint: 1-1024, default 512,
# and input + output <= 8192 tokens)
LLM_MAX_TOKENS=1024
# One active request per group key: calls from this process queue instead of colliding into 429s
LLM_MAX_CONCURRENCY=1
# Back-off (seconds) for HTTP 429/503 before giving up
LLM_RETRY_DELAYS=2,4,8
# Qwen3 reasoning mode: 0 (default) sends enable_thinking=false and strips <think> blocks
LLM_ENABLE_THINKING=0
EMBEDDING_API_BASE=https://your-endpoint.example/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# What the API and the UI use when a request doesn't say: mock|hosted and hashing|hosted
DEFAULT_LLM_PROVIDER=hosted
DEFAULT_EMBEDDING_PROVIDER=hashing

# --- API security and limits --------------------------------------------------------------
# Required for any server reachable by others: the UI sends it as X-API-Key. Make one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=
RATE_LIMIT_PER_MINUTE=60
# Comma-separated origins allowed to call the API from a browser (* = any)
CORS_ALLOW_ORIGINS=*
# Seconds an identical question's answer is reused (0 = off); saves LLM quota
ANSWER_CACHE_SECONDS=600
# LangGraph node executions per question (Track B cap: 10)
AGENT_MAX_STEPS=10
CONVERSATION_TTL_SECONDS=1800
# Conversation state survives restarts; every profile defaults to <RAG_HOME>/state/conversations.sqlite3
# CONVERSATION_DB=

# --- Retrieval ----------------------------------------------------------------------------
# Picked automatically: financial_qdrant when <RAG_HOME>/indexes/qdrant_db/ingest.sqlite3 exists,
# else financial_vlm (<RAG_HOME>/indexes/chroma_db), else the older Chroma index. Set to force one.
# RAG_BACKEND=financial_qdrant
# Cross-encoder rerank and the answer floor (no answer below this rerank score). Set automatically when
# <RAG_HOME>/models/ms-marco-MiniLM-L-6-v2 exists; or name the Hugging Face model to download it:
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RAG_MIN_RERANK_SCORE=
# Qdrant Cloud instead of the compose container:
# QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=
RAG_HTTP_TIMEOUT_SECONDS=45
RAG_REQUEST_TIMEOUT_SECONDS=60

# --- Tracing (LangSmith) ------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=annual-report-copilot

# --- Streamlit ----------------------------------------------------------------------------
API_TIMEOUT_SECONDS=180
UI_SHOW_ADVANCED=0

# --- Environment and storage (scripts/common/storage.py) -----------------------------------
# local (this PC) | colab (detected) | server (Docker anywhere) | gcp (Google Cloud VM). Compose defaults to server.
RAG_PROFILE=server
# Host folder mounted as RAG_HOME (/app/rag_home): indexes/qdrant_db, indexes/chroma_db, snapshots/, state/, models/.
# On a GCP VM put it on the persistent disk, e.g. /srv/capstone
RAG_HOME_DIR=./indexes/rag_home
# Folder with llm_ca.crt (the course endpoint's CA); mounted read-only, never committed
SECRETS_DIR=./secrets
# gcp: the bucket holding the index copies (Colab: cp.export_to_gcs; VM: sh deploy/sync_from_gcs.sh)
# RAG_GCS_BUCKET=gs://capstone-rag-<yourname>

# --- Docker compose -----------------------------------------------------------------------
# 127.0.0.1 = only this machine; 0.0.0.0 = anyone who can reach the server (use the https profile instead)
BIND_ADDRESS=127.0.0.1
# Your user id on Linux (id -u / id -g) so the mounted ./indexes stays writable
APP_UID=1000
APP_GID=1000
# Without a bucket: the folder holding what you copied from Drive (qdrant_db/*.snapshot + ingest.sqlite3,
# chroma_db/). deploy/restore_index.sh reads it when RAG_HOME has no snapshots of its own.
SNAPSHOT_DIR=./snapshots
# Pin to the Qdrant version that wrote the snapshots, or newer
QDRANT_IMAGE=qdrant/qdrant:latest

# --- HTTPS profile (docker compose --profile https up -d) ---------------------------------
DOMAIN=copilot.example.com
BASIC_AUTH_USER=demo
# docker run --rm caddy:2.8 caddy hash-password --plaintext 'your-password'
BASIC_AUTH_HASH=
